{
  "name": "personal-mcp-server",
  "version": "0.1.0",
  "description": "Personal MCP server for local services",
  "author": "Tim Hanson",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "happy-bridge": "node dist/src/happyBridge.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "tools:manifest:check": "tsx scripts/generate-tool-schema-manifest.ts --check config/tool-schema-manifest.json",
    "tools:manifest:update": "tsx scripts/generate-tool-schema-manifest.ts --write config/tool-schema-manifest.json",
    "chatgpt:refresh:check": "node skills/chatgpt-plugin-refresh/scripts/refresh-chatgpt-plugin.mjs --check-environment",
    "chatgpt:refresh:setup": "node skills/chatgpt-plugin-refresh/scripts/refresh-chatgpt-plugin.mjs --setup-profile",
    "docker:build": "npm run build && docker build -t personal-mcp-server .",
    "docker:tag": "docker image tag personal-mcp-server:latest ghcr.io/tbhanson96/personal-mcp-server:latest",
    "docker:push": "docker image push ghcr.io/tbhanson96/personal-mcp-server:latest",
    "package": "npm run docker:build",
    "deploy": "npm run docker:tag && npm run docker:push"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.2.1",
    "marked": "^18.0.6",
    "tweetnacl": "1.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "25.6.0",
    "rimraf": "6.1.3",
    "tsx": "^4.23.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "playwright": "1.56.1"
  },
  "overrides": {
    "@hono/node-server": "1.19.17",
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.8",
    "hono": "4.13.13",
    "ip-address": "10.7.4",
    "nanoid": "3.3.20",
    "postcss": "8.5.30",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "source-map-js": "1.2.2"
  }
}
