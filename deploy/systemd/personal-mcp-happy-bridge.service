[Unit]
Description=Restricted Happy bridge for Personal MCP
Wants=network-online.target happy-daemon.service
After=network-online.target happy-daemon.service

[Service]
Type=simple
EnvironmentFile=-%h/.config/personal-mcp-server/happy-bridge.env
ExecStart=%h/.nvm/versions/node/v24.6.0/bin/node %h/Repo/personal-mcp-server/dist/src/happyBridge.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/personal-mcp-server/happy-bridge
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
